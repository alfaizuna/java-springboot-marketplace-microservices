{
	"info": {
		"_postman_id": "c2a1f3e4-5d6b-7c8e-9f0a-1b2c3d4e5f6a",
		"name": "Marketplace Microservices API",
		"description": "Koleksi Postman resmi untuk Marketplace Microservices (Spring Boot 4, Java 21).\n\nFitur:\n- Auto-save accessToken & refreshToken ke Collection Variables setelah Login/Register/Refresh\n- Semua request ber-auth otomatis menggunakan {{accessToken}}\n- Flow lengkap: Auth → Products → Orders → Payment Webhook\n\nBase URL: http://localhost:8080 (via API Gateway)\n\nCollection Variables:\n- baseUrl: http://localhost:8080\n- accessToken: (auto-filled setelah login)\n- refreshToken: (auto-filled setelah login)\n- webhookSignature: (auto-filled setelah simulate-webhook)\n- webhookPayload: (auto-filled setelah simulate-webhook)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "webhookSignature",
			"value": "",
			"type": "string"
		},
		{
			"key": "webhookPayload",
			"value": "",
			"type": "string"
		},
		{
			"key": "lastOrderNumber",
			"value": "ORD-DEMO-001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.accessToken) {",
									"        pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"        console.log('Access Token saved:', jsonData.accessToken.substring(0, 30) + '...');",
									"    }",
									"    if (jsonData.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"        console.log('Refresh Token saved.');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Demo User\",\n  \"email\": \"demo@marketplace.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Daftarkan user baru. Mengembalikan accessToken (RS256 JWT) dan refreshToken.\nAuto-save token ke collection variables."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.accessToken) {",
									"        pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"        console.log('Access Token saved:', jsonData.accessToken.substring(0, 30) + '...');",
									"    }",
									"    if (jsonData.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"        console.log('Refresh Token saved.');",
									"    }",
									"    pm.test('Login successful', function() {",
									"        pm.response.to.have.status(200);",
									"        pm.expect(jsonData.accessToken).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@marketplace.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login dengan email dan password. Auto-save accessToken dan refreshToken ke collection variables."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.accessToken) {",
									"        pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"        console.log('New Access Token saved.');",
									"    }",
									"    if (jsonData.refreshToken) {",
									"        pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"        console.log('New Refresh Token saved (rotated).');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Perbarui access token menggunakan refresh token. Refresh token di-rotate setiap kali digunakan."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Logout dan blacklist access token saat ini ke Redis."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Products",
			"item": [
				{
					"name": "Browse Products (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"],
							"query": [
								{"key": "page", "value": "0"},
								{"key": "size", "value": "10"}
							]
						},
						"description": "Lihat katalog produk. Endpoint publik — tidak perlu JWT.\nMendukung paginasi: ?page=0&size=10"
					},
					"response": []
				},
				{
					"name": "Get Product Detail (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "1"]
						},
						"description": "Lihat detail produk berdasarkan ID. Endpoint publik."
					},
					"response": []
				},
				{
					"name": "Check Stock",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/SKU-LAPTOP-001/check-stock?quantity=2",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "SKU-LAPTOP-001", "check-stock"],
							"query": [
								{"key": "quantity", "value": "2"}
							]
						},
						"description": "Cek ketersediaan stok untuk SKU tertentu. Membutuhkan JWT."
					},
					"response": []
				},
				{
					"name": "Create Product (ADMIN only)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sku\": \"SKU-NEW-001\",\n  \"name\": \"Produk Baru\",\n  \"description\": \"Deskripsi produk baru\",\n  \"price\": 999000.00,\n  \"stock\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/products",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"]
						},
						"description": "Tambah produk baru. Hanya bisa diakses oleh user dengan role ADMIN.\nJika role bukan ADMIN, akan mengembalikan HTTP 403 Forbidden."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Orders",
			"item": [
				{
					"name": "Create Order (with Stock Check)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.orderNumber) {",
									"        pm.collectionVariables.set('lastOrderNumber', jsonData.orderNumber);",
									"        console.log('Order Number saved:', jsonData.orderNumber);",
									"    }",
									"    pm.test('Order created with PENDING status', function() {",
									"        pm.expect(jsonData.status).to.eql('PENDING');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderNumber\": \"ORD-DEMO-001\",\n  \"productSku\": \"SKU-LAPTOP-001\",\n  \"quantity\": 2,\n  \"amount\": 50000000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders"]
						},
						"description": "Buat order baru. order-service otomatis memanggil product-service untuk verifikasi stok sebelum menyimpan order.\n\nSkenario error:\n- SKU tidak ditemukan → HTTP 404\n- Stok tidak mencukupi → HTTP 422 Unprocessable Entity\n- product-service mati → HTTP 503 Service Unavailable"
					},
					"response": []
				},
				{
					"name": "Create Order - Stok Tidak Cukup (422)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderNumber\": \"ORD-FAIL-001\",\n  \"productSku\": \"SKU-LAPTOP-001\",\n  \"quantity\": 99999,\n  \"amount\": 1.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders"]
						},
						"description": "Test skenario stok tidak cukup. Harusnya mengembalikan HTTP 422 Unprocessable Entity dengan pesan insufficient stock."
					},
					"response": []
				},
				{
					"name": "Get Order Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/{{lastOrderNumber}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", "{{lastOrderNumber}}", "status"]
						},
						"description": "Cek status order terkini. Menggunakan {{lastOrderNumber}} yang di-save setelah Create Order."
					},
					"response": []
				},
				{
					"name": "Simulate Webhook (Generate Signature)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.valid_signature) {",
									"        pm.collectionVariables.set('webhookSignature', jsonData.valid_signature);",
									"        console.log('Webhook Signature saved.');",
									"    }",
									"    if (jsonData.raw_payload) {",
									"        pm.collectionVariables.set('webhookPayload', jsonData.raw_payload);",
									"        console.log('Webhook Payload saved.');",
									"    }",
									"    pm.test('Signature generated', function() {",
									"        pm.expect(jsonData.valid_signature).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/{{lastOrderNumber}}/simulate-webhook",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", "{{lastOrderNumber}}", "simulate-webhook"]
						},
						"description": "Generate payload mock + HMAC signature yang valid untuk testing webhook.\nAuto-save signature ke {{webhookSignature}} dan payload ke {{webhookPayload}}.\n\nJalankan request ini SEBELUM 'Send Valid Payment Webhook'."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Payment Webhook",
			"item": [
				{
					"name": "Send Valid Payment Webhook",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Webhook processed successfully', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"if (pm.response.code === 200) {",
									"    console.log('Webhook accepted! Order status should now be PAID.');",
									"    console.log('Run Get Order Status to verify.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Signature", "value": "{{webhookSignature}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{{webhookPayload}}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/webhooks/payment",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "webhooks", "payment"]
						},
						"description": "Kirim webhook pembayaran dengan signature HMAC yang valid.\nGunakan {{webhookSignature}} dan {{webhookPayload}} yang di-generate dari 'Simulate Webhook'.\n\nHasil: HTTP 200 → Order berubah status menjadi PAID"
					},
					"response": []
				},
				{
					"name": "Send Duplicate Webhook (Idempotency Test)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Duplicate webhook gracefully ignored (200)', function() {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include('Duplicate');",
									"});",
									"console.log('Idempotency works! Duplicate request ignored without double processing.');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Signature", "value": "{{webhookSignature}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{{webhookPayload}}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/webhooks/payment",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "webhooks", "payment"]
						},
						"description": "Kirim webhook yang sama dua kali untuk menguji Redis idempotency.\nHasil: HTTP 200 dengan pesan 'Duplicate notification ignored' (tidak memproses ulang)"
					},
					"response": []
				},
				{
					"name": "Send Webhook - Invalid Signature (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Invalid signature rejected with 401', function() {",
									"    pm.response.to.have.status(401);",
									"});",
									"console.log('Security works! Invalid HMAC signature rejected.');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Signature", "value": "ini_adalah_signature_palsu_dari_hacker"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transaction_id\": \"TRX-HACKER-001\",\n  \"order_number\": \"ORD-DEMO-001\",\n  \"gross_amount\": 1.00,\n  \"payment_type\": \"qris\",\n  \"transaction_status\": \"settlement\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/webhooks/payment",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "webhooks", "payment"]
						},
						"description": "Uji keamanan HMAC. Kirim payload dengan signature palsu.\nHasil: HTTP 401 Unauthorized — signature tidak valid ditolak seketika."
					},
					"response": []
				}
			]
		},

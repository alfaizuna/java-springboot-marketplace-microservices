# ==============================================================================
# Marketplace Microservices — Environment Variables Template
# Copy file ini menjadi .env untuk deployment lokal
# cp .env.example .env
# ==============================================================================

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=marketplace_db
DB_USERNAME=postgres
DB_PASSWORD=secret_password_here
DB_PORT=5432

# ── Redis (Token Blacklist + Idempotency) ─────────────────────────────────────
REDIS_PORT=6379

# ── JWT / RS256 Token Settings ────────────────────────────────────────────────
# 86400000 ms = 24 jam
JWT_EXPIRATION=86400000
# 604800000 ms = 7 hari
REFRESH_TOKEN_EXPIRATION=604800000

# ── Payment Webhook HMAC Secret ───────────────────────────────────────────────
# Ganti dengan nilai acak yang kuat di production!
PAYMENT_WEBHOOK_SECRET=super-secret-webhook-key-change-in-prod
